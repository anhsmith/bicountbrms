    border-radius:3px; background:rgba(200,120,40,.16); margin-left:.3rem; }
</style>

<div class="pca" id="pca">
  <div class="pca-bar">
    <button type="button" id="pca-resim">re-simulate</button>
    <label style="font-size:.82rem">seed
      <input type="number" id="pca-seed" value="7" style="width:5em"></label>
    <button type="button" id="pca-reset">reset</button>
  </div>

  <div class="pca-cols">
    <div class="pca-group">
      <h4>Interpretable coordinates</h4>
      <div id="pca-mfd"></div>
      <p class="pca-note" id="pca-note-mfd"></p>
    </div>
    <div class="pca-group">
      <h4>Native dpars (what <code>binegbin()</code> takes)</h4>
      <div id="pca-nat"></div>
      <p class="pca-note" id="pca-note-nat"></p>
    </div>
  </div>

  <div class="pca-plot" id="pca-plot"></div>
</div>

<script>
(function () {
  "use strict";

  // ---- seeded RNG, so a given seed always gives the same picture ----------
  var rngState = 1;
  function seedRng(s){ rngState = (s >>> 0) || 1; }
  function rand(){
    rngState |= 0; rngState = (rngState + 0x6D2B79F5) | 0;
    var t = Math.imul(rngState ^ (rngState >>> 15), 1 | rngState);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  }
  function randn(){
    var u = 0, v = 0;
    while (u === 0) u = rand();
    while (v === 0) v = rand();
    return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
  }
  function rgamma(shape){
    if (shape < 1) return rgamma(shape + 1) * Math.pow(rand(), 1 / shape);
    var d = shape - 1 / 3, c = 1 / Math.sqrt(9 * d);
    for (;;) {
      var x = randn(), v = Math.pow(1 + c * x, 3);
      if (v <= 0) continue;
      var u = rand();
      if (u < 1 - 0.0331 * x * x * x * x) return d * v;
      if (Math.log(u) < 0.5 * x * x + d * (1 - v + Math.log(v))) return d * v;
    }
  }
  function rpois(l){
    if (l <= 0) return 0;
    if (l < 30) { var L = Math.exp(-l), k = 0, p = 1;
      do { k++; p *= rand(); } while (p > L); return k - 1; }
    return Math.max(0, Math.round(l + Math.sqrt(l) * randn()));
  }
  // NB2 with SD-scale kappa: phi = 1/kappa^2, and kappa = 0 IS Poisson.
  function rnbinom(mu, kappa){
    if (kappa <= 0) return rpois(mu);
    var phi = 1 / (kappa * kappa);
    return rpois(rgamma(phi) * (mu / phi));
  }

  // ---- the map, stated once ----------------------------------------------
  // Mirrors binegbin_mfd_to_dpars() / binegbin_dpars_to_mfd() exactly.
  function toNative(s){
    var mid = s.M * (1 - s.f);
    return {
      mu:     s.M * s.f,
      lone:   mid * (1 + s.b),
      ltwo:   mid * (1 - s.b),
      shapes: s.kA <= 0 ? Infinity : 1 / (s.kA * s.kA),
      shapex: s.kX <= 0 ? Infinity : 1 / (s.kX * s.kX)
    };
  }
  // Degenerate directions: f undefined at M = 0, bias undefined when there is
  // no excess to be biased. Hold the last identified value rather than
  // snapping to 0 -- 0 would assert an unbiased method the state cannot
  // support, and would make the knob jump under the user's finger.
  var lastF = 0.67, lastB = 0, degenerate = null;
  function fromNative(n){
    var sum = n.lone + n.ltwo, M = n.mu + sum / 2;
    degenerate = null;
    var f = M > 0 ? n.mu / M : (degenerate = "M = 0: congruence undefined", lastF);
    var b = sum > 0 ? (n.lone - n.ltwo) / sum
                    : (degenerate = "no excess: bias unidentified", lastB);
    if (M > 0) lastF = f;
    if (sum > 0) lastB = b;
    return {
      M: M, f: f, b: b,
      kA: isFinite(n.shapes) ? 1 / Math.sqrt(n.shapes) : 0,
      kX: isFinite(n.shapex) ? 1 / Math.sqrt(n.shapex) : 0
    };
  }

  // ---- dial specs --------------------------------------------------------
  // Shape dials are log10-scaled: shape spans orders of magnitude, and its
  // Poisson limit is at infinity. LOG_MAX is the top of the slider; kappa = 0
  // parks it there and the readout shows the true infinity.
  var LOG_MIN = -1, LOG_MAX = 3;

  var MFD = [
    {k:"M",  lab:"Level <b>M</b>",             min:0.5, max:30, step:0.5,  dp:1},
    {k:"f",  lab:"Congruence <b>f</b>",        min:0,   max:1,  step:0.01, dp:2},
    {k:"b",  lab:"Bias <b>&beta;</b>",         min:-1,  max:1,  step:0.02, dp:2},
    {k:"kA", lab:"<b>&kappa;<sub>A</sub></b> shared",  min:0, max:3, step:0.05, dp:2},
    {k:"kX", lab:"<b>&kappa;<sub>X</sub></b> excess",  min:0, max:3, step:0.05, dp:2}
  ];
  var NAT = [
    {k:"mu",     lab:"<code>mu</code>",        min:0, max:30, step:0.1, dp:2},
    {k:"lone",   lab:"<code>lambdaone</code>", min:0, max:30, step:0.1, dp:2},
    {k:"ltwo",   lab:"<code>lambdatwo</code>", min:0, max:30, step:0.1, dp:2},
    {k:"shapes", lab:"<code>shapes</code>",    log:true, dp:2},
    {k:"shapex", lab:"<code>shapexone</code> = <code>shapextwo</code>", log:true, dp:2}
  ];

  var DEFAULTS = {M:12, f:0.67, b:0, kA:0.6, kX:1.0};
  var S = Object.assign({}, DEFAULTS);
  var NSETS = 10, sets = [];

  var $ = function(id){ return document.getElementById(id); };
  var dials = {};

  function buildDial(spec, host, side){
    var wrap = document.createElement("div");
    wrap.className = "pca-dial";
    wrap.innerHTML = '<span class="lab">' + spec.lab + "</span>";
    var inp = document.createElement("input");
    inp.type = "range";
    if (spec.log) { inp.min = LOG_MIN; inp.max = LOG_MAX; inp.step = 0.01; }
    else { inp.min = spec.min; inp.max = spec.max; inp.step = spec.step; }
    var num = document.createElement("input");
    num.type = "text"; num.className = "val";
    wrap.appendChild(inp); wrap.appendChild(num);
    host.appendChild(wrap);
    dials[spec.k] = {inp:inp, num:num, spec:spec, side:side};

    // One side is the source of truth per interaction: the side you touched is
    // read in full, converted, and written to the other. Neither side mutates
    // the other incrementally, so repeated round-tripping cannot drift.
    inp.addEventListener("input", function(){ drive(side); });
    num.addEventListener("change", function(){
      var v = parseFloat(num.value);
      if (isFinite(v)) { setDial(spec.k, v); drive(side); }
      else render();
    });
  }

  function setDial(k, value){
    var d = dials[k];
    if (d.spec.log) {
      var lv = (!isFinite(value) || value <= 0) ? LOG_MAX
             : Math.min(LOG_MAX, Math.max(LOG_MIN, Math.log10(value)));
      d.inp.value = lv;
    } else {
      d.inp.value = Math.min(d.spec.max, Math.max(d.spec.min, value));
    }
  }
  function getDial(k){
    var d = dials[k];
    return d.spec.log ? Math.pow(10, parseFloat(d.inp.value)) : parseFloat(d.inp.value);
  }

  function drive(side){
    if (side === "mfd") {
      S = {M:getDial("M"), f:getDial("f"), b:getDial("b"),
           kA:getDial("kA"), kX:getDial("kX")};
      degenerate = null;
    } else {
      // kappa = 0 is unreachable from a finite shape slider; treat the top of
      // the log range as the Poisson limit so the two sides can agree there.
      var sh = parseFloat(dials.shapes.inp.value) >= LOG_MAX ? Infinity : getDial("shapes");
      var sx = parseFloat(dials.shapex.inp.value) >= LOG_MAX ? Infinity : getDial("shapex");
      S = fromNative({mu:getDial("mu"), lone:getDial("lone"),
                      ltwo:getDial("ltwo"), shapes:sh, shapex:sx});
    }
    resimulate();
  }

  function resimulate(){
    seedRng(parseInt($("pca-seed").value, 10) || 1);
    var n = toNative(S), out = [];
    for (var i = 0; i < NSETS; i++) {
      var A = rnbinom(n.mu, S.kA);
      out.push({A:A,
                one:A + rnbinom(n.lone, S.kX),
                two:A + rnbinom(n.ltwo, S.kX)});
    }
    sets = out;
    render();
  }

  function fmt(v, dp){
    if (!isFinite(v)) return "∞";
    return v.toFixed(dp);
  }

  function render(){
    var n = toNative(S);
    // Write BOTH sides from the single state, every time.
    setDial("M", S.M); setDial("f", S.f); setDial("b", S.b);
    setDial("kA", S.kA); setDial("kX", S.kX);
    setDial("mu", n.mu); setDial("lone", n.lone); setDial("ltwo", n.ltwo);
    setDial("shapes", n.shapes); setDial("shapex", n.shapex);

    dials.M.num.value  = fmt(S.M, 1);
    dials.f.num.value  = fmt(S.f, 2);
    dials.b.num.value  = fmt(S.b, 2);
    dials.kA.num.value = fmt(S.kA, 2);
    dials.kX.num.value = fmt(S.kX, 2);
    dials.mu.num.value     = fmt(n.mu, 2);
    dials.lone.num.value    = fmt(n.lone, 2);
    dials.ltwo.num.value    = fmt(n.ltwo, 2);
    dials.shapes.num.value = fmt(n.shapes, 2);
    dials.shapex.num.value = fmt(n.shapex, 2);

    $("pca-note-mfd").innerHTML =
      "&kappa; = 0 is the Poisson floor, reachable at a finite zero."
      + (degenerate ? '<span class="pca-flag">' + degenerate + " &mdash; holding last value</span>" : "");
    $("pca-note-nat").innerHTML =
      "<code>shapes</code> and the two <code>shapex*</code> are NB2 <i>&phi;</i>: <b>larger means less "
      + "overdispersed</b>, and Poisson is the <i>&phi;</i> &rarr; &infin; limit &mdash; off the end "
      + "of any finite slider. That asymmetry is why &kappa; = 1/&radic;<i>&phi;</i> is the nicer dial.";

    $("pca-plot").innerHTML = draw(n);
  }

  // ---- drawing -----------------------------------------------------------
  var SLOT = 12, GW = 11, COL = 15, PAIRW = 2 * COL, PITCH = PAIRW + 15;
  var ML = 46, MR = 14, MT = 16, MB = 32, BARW = 17, BARGAP = 5, BOXPAD = 9;
  var PANELW = 2 * BARW + BARGAP + 2 * BOXPAD;

  function yMaxOf(n){
    var vA = n.mu + S.kA * S.kA * n.mu * n.mu;
    var need = Math.max(n.lone, n.ltwo) * 0 + Math.max(
      (n.mu + n.lone) + 3 * Math.sqrt(vA + n.lone + S.kX * S.kX * n.lone * n.lone),
      (n.mu + n.ltwo) + 3 * Math.sqrt(vA + n.ltwo + S.kX * S.kX * n.ltwo * n.ltwo)
    );
    return Math.max(8, Math.min(34, Math.ceil(need)));
  }

  function draw(n){
    var yMax = yMaxOf(n), panelX = ML, setsX = panelX + PANELW + 20;
    var W = setsX + NSETS * PITCH - (PITCH - PAIRW) + MR;
    var H = MT + yMax * SLOT + MB;
    var Y = function(v){ return MT + (yMax - v) * SLOT; };
    var s = '<svg width="' + W + '" height="' + H + '" viewBox="0 0 ' + W + " " + H
          + '" font-size="10" role="img" aria-label="Decomposition of a paired count into a shared component and two source-specific excesses">';

    // expected panel: CONTINUOUS bars, because these are rates, not counts
    var boxY = Y(yMax) - 4, boxH = Y(0) - boxY + 4;
    s += '<rect x="' + (panelX - 2) + '" y="' + boxY + '" width="' + (PANELW + 4)
       + '" height="' + boxH + '" fill="var(--pca-panel)" stroke="var(--pca-edge)" rx="4"/>';
    s += '<text x="' + (panelX + PANELW / 2) + '" y="' + (boxY - 4)
       + '" text-anchor="middle" opacity=".7">expected</text>';

    var lam = [n.ltwo, n.lone], cols = ["var(--pca-two)", "var(--pca-one)"], nm = ["y2", "y1"];
    for (var k = 0; k < 2; k++) {
      var bx = panelX + BOXPAD + k * (BARW + BARGAP);
      s += '<rect x="' + bx + '" y="' + Y(n.mu).toFixed(1) + '" width="' + BARW
         + '" height="' + (n.mu * SLOT).toFixed(1) + '" fill="var(--pca-shared)" fill-opacity=".45"/>';
      s += '<rect x="' + bx + '" y="' + Y(n.mu + lam[k]).toFixed(1) + '" width="' + BARW
         + '" height="' + (lam[k] * SLOT).toFixed(1) + '" fill="' + cols[k] + '" fill-opacity=".45"/>';
      s += '<text x="' + (bx + BARW / 2) + '" y="' + (Y(0) + 12)
         + '" text-anchor="middle" font-weight="600" fill="' + cols[k] + '">' + nm[k] + "</text>";
    }

    // the two parameter rules cross every simulated pair
    s += '<line x1="' + (panelX + BOXPAD) + '" y1="' + Y(S.M).toFixed(1) + '" x2="' + (W - MR + 6)
       + '" y2="' + Y(S.M).toFixed(1) + '" stroke="var(--pca-ink)" stroke-width="1.2" stroke-dasharray="1.5,2.5"/>';
    s += '<text x="' + (ML - 6) + '" y="' + (Y(S.M) + 3.5).toFixed(1)
       + '" text-anchor="end" font-style="italic" font-size="12">M</text>';
    s += '<line x1="' + (panelX + BOXPAD) + '" y1="' + Y(n.mu).toFixed(1) + '" x2="' + (W - MR + 6)
       + '" y2="' + Y(n.mu).toFixed(1) + '" stroke="var(--pca-shared-d)" stroke-width="1.2" stroke-dasharray="6,3"/>';
    s += '<text x="' + (ML - 6) + '" y="' + (Y(n.mu) + 3.5).toFixed(1)
       + '" text-anchor="end" font-size="12">mu</text>';

    // realised pairs: DISCRETE marks
    for (var i = 0; i < NSETS; i++) {
      var d = sets[i], pcx = setsX + i * PITCH + PAIRW / 2;
      var sides = [["y2", d.two, "var(--pca-two)"], ["y1", d.one, "var(--pca-one)"]];
      for (var j = 0; j < 2; j++) {
        var side = sides[j], x = (j === 0) ? pcx - COL : pcx;
        var shown = Math.min(side[1], yMax);
        for (var q = 1; q <= shown; q++) {
          var col = (q <= d.A) ? "var(--pca-shared)" : side[2];
          s += '<rect x="' + (x + (COL - GW) / 2).toFixed(1) + '" y="' + (Y(q - 0.5) - GW / 2 + 1).toFixed(1)
             + '" width="' + GW + '" height="' + (GW - 2) + '" rx="2.5" fill="' + col + '"/>';
        }
        if (side[1] > yMax) {
          s += '<text x="' + (x + COL / 2).toFixed(1) + '" y="' + (Y(yMax) - 3).toFixed(1)
             + '" text-anchor="middle" opacity=".8">+' + (side[1] - yMax) + "</text>";
        }
      }
      s += '<line x1="' + (pcx - COL - 2).toFixed(1) + '" y1="' + Y(d.A).toFixed(1) + '" x2="'
         + (pcx + COL + 2).toFixed(1) + '" y2="' + Y(d.A).toFixed(1)
         + '" stroke="var(--pca-shared-d)" stroke-width="1.6"/>';
    }

    s += '<line x1="' + (panelX - 2) + '" y1="' + Y(0).toFixed(1) + '" x2="' + (W - MR + 6)
       + '" y2="' + Y(0).toFixed(1) + '" stroke="var(--pca-rule)"/>';
    s += '<text x="' + (ML - 6) + '" y="' + (Y(0) + 3.5).toFixed(1) + '" text-anchor="end" opacity=".6">0</text>';
    s += '<text x="' + (setsX + (NSETS * PITCH - (PITCH - PAIRW)) / 2) + '" y="' + (H - 4)
       + '" text-anchor="middle" opacity=".6">ten simulated pairs</text>';
    return s + "</svg>";
  }

  // ---- wire up -----------------------------------------------------------
  MFD.forEach(function(d){ buildDial(d, $("pca-mfd"), "mfd"); });
  NAT.forEach(function(d){ buildDial(d, $("pca-nat"), "nat"); });
  $("pca-resim").addEventListener("click", function(){
    $("pca-seed").value = (parseInt($("pca-seed").value, 10) || 1) + 1;
    resimulate();
  });
  $("pca-seed").addEventListener("change", resimulate);
  $("pca-reset").addEventListener("click", function(){
    S = Object.assign({}, DEFAULTS); lastF = DEFAULTS.f; lastB = DEFAULTS.b;
    resimulate();
  });
  resimulate();
})();
</script>
```

## Things to try

**Turn `f` up towards 1.** Both excess rates fall to zero and the two bars
converge: the sources agree completely. Now notice what happens to $\beta$: it
stops meaning anything. There is no excess left to be biased, so the bias is
*unidentified*, and the widget flags it and holds the last value rather than
snapping to zero. Zero would be a claim (the methods are unbiased) that the
state cannot support.

**Drag `lambdaone` alone.** $M$, $f$ and $\beta$ all move, because changing one
excess rate changes the overall level, the shared share, *and* the imbalance
simultaneously. This is exactly why the native coordinates are awkward to
reason in, and it is much easier to see than to describe.

**Turn $\beta$ up and watch $M$.** The two bars separate, but the $M$ rule
does not move: it stays at their *average*, touching neither. The average of
the two excess rates is $M(1-f)$ for any $\beta$, so $M$ is pinned to the
midpoint whatever the bias. $M$ is a midpoint of what the sources *report*, not
a property of the underlying process.

**Compare $\kappa_A$ against $\kappa_X$.** They are near-orthogonal channels.
$\kappa_A$ moves the pair up and down *together*, and cannot alter the
difference, because the shared component cancels out of that difference.
$\kappa_X$ pulls the pair *apart*, and drives the whole difference.

**Push $\kappa_A$ to 0.** The counts do not stop moving. That is the Poisson
floor, not determinism: there is no parameter setting that stills the stacks.

## The same map, in R

The widget's arithmetic is not a separate model: it is the package's own map,
which you can call directly. The R code below is the authoritative version, and
the JavaScript above is checked against it:

```{r}
#| label: map
library(bicountbrms)

# The widget's defaults
binegbin_mfd_to_dpars(M = 12, f = 0.67, delta = atanh(0), kappas = 0.6, kappax = 1.0)
```

`delta` is the unbounded log-ratio bias; the widget's $\beta$ is the bounded
$\tanh\delta$. Going back the other way:

```{r}
#| label: inverse
d <- binegbin_mfd_to_dpars(M = 12, f = 0.67, delta = 0.3)
binegbin_dpars_to_mfd(d$mu, d$lambdaone, d$lambdatwo)[c("M", "f", "delta", "beta")]
```

And the degenerate case the widget flags:

```{r}
#| label: degenerate
# Perfect congruence: no excess, so no bias to identify
binegbin_dpars_to_mfd(mu = 12, lambdaone = 0, lambdatwo = 0)$delta
```

## Fitting in these coordinates

Nothing above fits a model: the map and its inverse are coordinate transforms.
To *fit* in $(M, f, \delta)$ you do not need a different family: the
reparameterisation is reachable through a non-linear formula, with

$$\eta = \log M, \qquad \mathrm{con} = \operatorname{logit} f,
\qquad \mathrm{methd} = \delta.$$

Every dpar is log-linked, so each formula below is written on the log scale and
the link supplies the `exp()`. That includes the two dispersions: writing
`shapes` as $-2\log\kappa_s$ gives $\text{shapes} = e^{-2\log\kappa_s} =
1/\kappa_s^2$, so the model is estimated in $\kappa$, the SD-scale dispersion
the widget above uses, rather than in $\phi$.

$\kappa = 0$ is the Poisson limit, so a prior on $\kappa$ can shrink towards
Poisson. The same reparameterisation was used in
[@smithInstantaneousVsNoninstantaneous2020].

### Priors that default to the simpler model

This section covers priors in the \eqn{(M, f, \delta)} coordinates alone.
For the native distributional parameters — which prior goes in which of the
`class`, `dpar` and `nlpar` slots, and why brms supplies none of them by
default — see [Choosing priors](choosing-priors.html), which is the page to
read first.

Three of these coordinates have a **null at a finite, interpretable zero**. The
priors below follow from three statements about that null. Zero is the base
model: $\kappa = 0$ is a Poisson component, $\delta = 0$ is no bias between the
two sources. A coordinate's effect on the fit grows as it moves away from zero.
The prior's density should therefore decrease monotonically away from zero,
leaving the data rather than the prior to move the estimate off the base model.

The third statement is Occam's razor in the sense of
@simpsonPenalisingModelComponent2017 (their Principle 1), with the scale chosen
by what the analyst is willing to permit (their Principle 4). These priors
follow the same principles as
penalised-complexity priors: a base model at zero, and a density decaying away
from it. They are not PC priors in the strict sense, which would require a
distance measure derived for this family and a constant-rate assumption on that
distance. Neither is established here.

| coordinate | base model | prior |
|---|---|---|
| $\delta$ (`methd`) | $0$ — no method bias, $\lambda_1 = \lambda_2$ | `normal(0, 0.5)` |
| $\kappa_s$ (`kappas`) | $0$ — Poisson shared component | `normal(0, 1)`, $\kappa \ge 0$ |
| $\kappa_x$ (`kappax`) | $0$ — Poisson private components | `normal(0, 1)`, $\kappa \ge 0$ |
| $\operatorname{logit} f$ (`con`) | none — deliberately, see below | `normal(0, 1.5)` |

Note what changes on the $\kappa$ scale. In $\phi$ the Poisson limit is $\phi \to \infty$,
so there is no finite point to shrink towards, and a density decaying from zero
would pull towards *maximum* overdispersion. In $\kappa$ the limit is $\kappa =
0$, so the same density shrinks towards Poisson.

Those four priors **transfer between datasets unchanged**, because every one of
them is scale-free: a log-ratio, two coefficient-of-variation-like quantities,
and a proportion. None of them refers to how big the counts are.

**The scale sets what the prior permits.** On $\kappa$, `lb = 0` makes
`normal(0, 1)` a half-normal, which places 5% of its mass beyond $\kappa =
1.96$. Since $\kappa$ is the overdispersion standard deviation as a multiple of
the mean, that permits a component whose excess variation has a standard
deviation about twice its own mean. Whether that is generous or restrictive
depends on the counts being modelled. The coordinate is scale-free, so 1.96
means the same thing whatever the counts; whether it is a plausible upper reach
for yours is the question to settle before adopting the scale used here.

`exponential(1)` is an alternative of the same shape, with its maximum at zero,
decaying monotonically, and a heavier tail. The two agree at the median to
within 3% ($0.693$ against $0.674$) and separate further out: 5.0% of the
exponential's mass lies beyond $\kappa = 3$, against 0.27% of the
half-normal's. Either satisfies the three statements above, so the choice is how
much overdispersion the prior permits before the data are consulted.
@simpsonPenalisingModelComponent2017 §3.2 discusses heavy tails and their
numerical behaviour.

**Congruence is deliberately not shrunk either way.** Both ends of $f$ are
degenerate — at $f = 1$ there is no excess left, so $\delta$ becomes
unidentified; at $f = 0$ there is no shared component at all — and neither is a
natural null for a method comparison. `normal(0, 1.5)` on $\operatorname{logit}
f$ is close to flat over the interior (implied density within 10% of uniform
across $f \in [0.1, 0.9]$) while falling away at both boundaries, so it declines
to take a side. @mcelreath2020 makes the same case for that prior on a
logit-scale parameter, against the wider normals, which place nearly all their
mass near $f = 0$ and $f = 1$.

### Setting the prior on $M$ from your own counts

$M$ is the only coordinate on the counts' own scale, so its prior is the only
one here without a universal default. Set that prior from your own counts.

`normal(4, 1.5)` is used below, which covers roughly 3 to 1000 counts per
sampling unit and suits the simulated data. For sparser data, lower the mean:
`normal(0, 2)` covers about 0.04 to 27.

Move the **mean** to match your scale rather than raising the SD. `eta` is
$\log M$, so a normal prior on it is a lognormal on $M$, and widening one pushes
mass out to implausible values instead of making it neutral
[@smithInstantaneousVsNoninstantaneous2020, supplement 3, Fig. S3-1].

A prior written on one scale induces a different density on any other. Being
weakly informative on the first does not make it so on the second. These are
written on the linear-predictor scale — $\log M$, $\operatorname{logit} f$ — so
what matters is the density they induce after the change of variables, on the
scale being interpreted [@mcelreath2020]. Those induced densities are plotted
below, with $\delta$ shown as the bounded bias $\beta = \tanh\delta$, the
fractional imbalance of excess between the two sources:

```{r}
#| label: prior-pushforward
#| fig.width: 8
#| fig.height: 5.6
#| fig.alt: >
#|   Four panels showing the implied prior density on the interpretable scale:
#|   overall level M, congruence f, bounded bias beta, and dispersion kappa.
op <- par(mfrow = c(2, 2), mar = c(4.1, 4.1, 2.6, 1.1), bty = "n")

# eta ~ normal(4, 1.5) on log M  =>  M is lognormal
M <- seq(0.5, 250, length.out = 200)
plot(M, dlnorm(M, 4, 1.5), type = "l", lwd = 2, col = "#2D6A7F",
     xlab = "M  (overall level)", ylab = "density",
     main = "log M ~ normal(4, 1.5)")

# con ~ normal(0, 1.5) on logit f  =>  Jacobian 1 / (f (1 - f))
f <- seq(0.001, 0.999, length.out = 200)
plot(f, dnorm(qlogis(f), 0, 1.5) / (f * (1 - f)), type = "l", lwd = 2,
     col = "#8A8072", ylim = c(0, 1.4),
     xlab = "f  (congruence)", ylab = "density",
     main = "logit f ~ normal(0, 1.5)")
abline(h = 1, lty = 3)                      # uniform, for comparison
mtext("dotted line = uniform", side = 3, line = -1.1, cex = 0.7, adj = 0.97)

# methd ~ normal(0, 0.5) on delta; beta = tanh(delta)
beta <- seq(-0.985, 0.985, length.out = 200)
plot(beta, dnorm(atanh(beta), 0, 0.5) / (1 - beta^2), type = "l", lwd = 2,
     col = "#C4622D",
     xlab = expression(beta == tanh(delta) ~ "  (method bias)"),
     ylab = "density", main = "shrinks to no bias")
abline(v = 0, lty = 3)

# kappas, kappax ~ normal(0, 1) with lb = 0, i.e. half-normal;
# kappa = 0 IS the Poisson limit
k <- seq(0, 4, length.out = 200)
plot(k, 2 * dnorm(k, 0, 1), type = "l", lwd = 2, col = "#6B5D4F",
     xlab = expression(kappa ~ "  (dispersion, SD scale)"),
     ylab = "density", main = "shrinks to Poisson")
abline(v = 0, lty = 3)
mtext(expression(kappa == 0 ~ "is Poisson"), side = 3, line = -1.1,
      cex = 0.7, adj = 0.97)

par(op)
```

The priors on $\beta$ and $\kappa$ concentrate mass at the null and decay away
from it. The prior on $f$ is flat across the interior and declines only where
the model degenerates. None is tight enough to dominate 400 observations, and the
fit below tests that claim.

Simulate a pair of counts from known coordinates:

```{r}
#| label: mfd-sim
#| message: false
library(brms)
library(bicountbrms)

set.seed(20260731)

M_true  <- 12
f_true  <- 0.67
d_true  <- 0.3
ks_true <- 0.5
kx_true <- 0.6

truth <- binegbin_mfd_to_dpars(
  M      = M_true,
  f      = f_true,
  delta  = d_true,
  kappas = ks_true,
  kappax = kx_true
)

n  <- 400
Ns <- rnbinom(n, size = truth$shapes, mu = truth$mu)

dat <- data.frame(
  y1 = Ns + rnbinom(n, size = truth$shapexone, mu = truth$lambdaone),
  y2 = Ns + rnbinom(n, size = truth$shapextwo, mu = truth$lambdatwo)
)

unlist(truth)
```

Fit. Every prior either shrinks towards the simpler model or is centred away from the
truth, so what comes back is carried by the data rather than echoed from the
prior:

```{r}
#| label: mfd-fit
#| results: hide
#| message: false
fit <- brm(
  bf(y1 | vint(y2) ~ 1, nl = TRUE) +
    nlf(mu        ~ eta + log_inv_logit(con)) +
    nlf(lambdaone ~ log(2) + eta + log_inv_logit(-con) + log_inv_logit( 2 * methd)) +
    nlf(lambdatwo ~ log(2) + eta + log_inv_logit(-con) + log_inv_logit(-2 * methd)) +
    nlf(shapes    ~ -2 * log(kappas)) +
    nlf(shapexone ~ -2 * log(kappax)) +
    nlf(shapextwo ~ -2 * log(kappax)) +
    lf(eta ~ 1, con ~ 1, methd ~ 1, kappas ~ 1, kappax ~ 1),
  family   = binegbin(),
  stanvars = binegbin_stanvars(),
  data     = dat,
  prior    = c(
    prior(normal(4, 1.5), class = "b", nlpar = "eta"),
    prior(normal(0, 1.5), class = "b", nlpar = "con"),
    prior(normal(0, 0.5), class = "b", nlpar = "methd"),
    prior(normal(0, 1),   class = "b", nlpar = "kappas", lb = 0),
    prior(normal(0, 1),   class = "b", nlpar = "kappax", lb = 0)
  ),
  chains  = 2,
  iter    = 2000,
  warmup  = 1000,
  refresh = 0,
  seed    = 20260731
)
```

The coordinates are read off the posterior directly: `eta` exponentiates to
$M$, `con` inverse-logits to $f$, and `methd` and the two `kappa`s *are* the
coordinates themselves, with no transformation needed:

```{r}
#| label: mfd-recover
post <- as_draws_df(fit)

qi <- function(x) c(median(x), quantile(x, c(0.05, 0.95)))

recovered <- rbind(
  M      = qi(exp(post$b_eta_Intercept)),
  f      = qi(plogis(post$b_con_Intercept)),
  delta  = qi(post$b_methd_Intercept),
  kappas = qi(post$b_kappas_Intercept),
  kappax = qi(post$b_kappax_Intercept)
)
colnames(recovered) <- c("median", "q5", "q95")

knitr::kable(
  cbind(truth = c(M_true, f_true, d_true, ks_true, kx_true), recovered),
  digits = 3
)
```

Because the map is a bijection, the same posterior can be read in native dpars
without refitting: push the draws back through
[`binegbin_mfd_to_dpars()`](../reference/binegbin_mfd_to_dpars.html):

```{r}
#| label: mfd-back
back <- binegbin_mfd_to_dpars(
  M     = exp(post$b_eta_Intercept),
  f     = plogis(post$b_con_Intercept),
  delta = post$b_methd_Intercept
)

knitr::kable(
  data.frame(
    dpar   = c("mu", "lambdaone", "lambdatwo"),
    truth  = c(truth$mu, truth$lambdaone, truth$lambdatwo),
    median = vapply(back, median, numeric(1))
  ),
  digits = 3,
  row.names = FALSE
)
```

The reason to bother with any of this: putting a random effect on `eta` asks
whether groups differ in overall level, and putting one on `con` asks whether
they differ in congruence. Those are separable questions in these coordinates
and entangled ones in the native dpars, where a group effect on `mu` alone
changes the level and the congruence at once.

## A caveat about the widget

The JavaScript is an independent implementation of the *generative* model: it
draws from the same trivariate reduction, but it is not the likelihood, and no
part of the package's inference runs in your browser. The rate map it uses is
the one tested in `test-mfd.R`; the sampler is illustrative. Treat the picture
as intuition, and the R above as the specification.

The widget also shows ONE excess-dispersion dial. `binegbin()` estimates two,
`shapexone` and `shapextwo`, and the (M, f, delta) coordinates this article
is about use one `kappax` for both -- so the dial sets both to the same
value, which is the symmetric special case. Freeing them means giving each
its own `nlf()` line, as the fit above would if the two margins were allowed
to differ.

