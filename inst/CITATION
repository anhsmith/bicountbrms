# Version and year are taken from DESCRIPTION so there is one source of truth;
# bumping Version/Date is enough to keep citation() current.
#
# DOI. The concept DOI below resolves to whichever version is latest, so it does
# not change when a new release is archived and needs no edit at each release.
# The DOI of one particular release is on that release's own Zenodo record, and
# belongs in a reproducibility statement rather than here.
year <- if (!is.null(meta$Date)) {
  format(as.Date(meta$Date), "%Y")
} else {
  format(Sys.Date(), "%Y")
}
version <- meta$Version

citHeader(
  "To cite bicountbrms in publications, cite the package itself and, ",
  "because every family here is a brms custom family, brms as well ",
  "(citation(\"brms\")). If you use a specific family, please also cite the ",
  "distribution it implements: Holgate (1964) for the trivariate-reduction ",
  "representation and Karlis & Ntzoufras (2003) for its regression form. ",
  "Full references are given in the article ",
  "\"The families and their parameters\", at ",
  "https://anhsmith.github.io/bicountbrms/articles/families-and-parameters.html"
)

bibentry(
  bibtype  = "Manual",
  title    = "{bicountbrms}: Joint Bivariate-Count {brms} Custom Families for Paired Counts",
  author   = person(
    "Adam N. H.", "Smith",
    comment = c(ORCID = "0000-0003-0059-6206")
  ),
  year     = year,
  note     = paste("R package version", version),
  doi      = "10.5281/zenodo.22239120",
  url      = "https://github.com/anhsmith/bicountbrms",
  header   = "Package citation:",
  textVersion = paste0(
    "Smith, A. N. H. (", year, "). bicountbrms: Joint Bivariate-Count brms ",
    "Custom Families for Paired Counts. ",
    "R package version ", version, ". ",
    "https://doi.org/10.5281/zenodo.22239120"
  )
)
