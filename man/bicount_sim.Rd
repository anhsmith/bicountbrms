dat$y1[dat$y1_obs == 0] <- 0L

fit <- brm(
  bf(y1 | vint(y2, y1_obs) ~ 1, nl = TRUE) +
    nlf(mu        ~ logM + log_inv_logit(logitf)) +
    nlf(lambdaone ~ log(2) + logM + log_inv_logit(-logitf) +
